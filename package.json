{
  "name": "lo-que-dijo-la-gente-electron",
  "productName": "Lo Que Dijo la Gente",
  "version": "1.0.0",
  "description": "Juego de encuestas por equipos con consola para el conductor y pantalla para el proyector. Funciona sin internet.",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "electron": "electron .",
    "test": "vitest",
    "dist:linux": "vite build && electron-builder --linux AppImage --x64",
    "dist:linux:dir": "vite build && electron-builder --linux dir",
    "dist:win": "vite build && electron-builder --win nsis portable --x64",
    "dist:win:container": "bash scripts/dist-win-container.sh",
    "dist:mac": "vite build && electron-builder --mac dmg zip --arm64 --x64",
    "dist:mac:zip": "vite build && electron-builder --mac zip --arm64 --x64",
    "dist:all": "bash scripts/dist-all.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "mx.juego.loquedijolagente",
    "productName": "Lo Que Dijo la Gente",
    "files": ["dist/**/*", "electron/**/*", "!electron/**/*.test.*", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "LoQueDijoLaGente-${version}-Windows-Setup.${ext}" },
    "portable": { "artifactName": "LoQueDijoLaGente-${version}-Windows-Portable.${ext}" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.games", "identity": null, "artifactName": "LoQueDijoLaGente-${version}-Mac-${arch}.${ext}" },
    "linux": { "target": ["AppImage"], "category": "Game", "executableName": "lo-que-dijo-la-gente", "artifactName": "LoQueDijoLaGente-${version}-Linux-${arch}.${ext}" }
  }
}
